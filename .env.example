# GovShield v3.2 — Environment Variables
# Copy this file to .env and fill in your values
# ================================================

# ── Flask ─────────────────────────────────────────────────────────────────────
# REQUIRED for production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-here

# Set to "true" only during development
FLASK_DEBUG=false

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5000,https://yourdomain.gov.in

# ── Claude AI (for chat assistant) ───────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Ollama (primary local AI engine for chat assistant) ──────────────────────
# GovShield tries Ollama first, then Claude, then a rule-based fallback.
# Requires Ollama installed locally: https://ollama.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:latest

# ── Gunicorn (production) ─────────────────────────────────────────────────────
WEB_CONCURRENCY=4
